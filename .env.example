# Copy to .env. Nothing here is required for local dev against compose defaults.
DJANGO_SETTINGS_MODULE=tally.settings.dev
DJANGO_SECRET_KEY=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=tally
POSTGRES_USER=tally
POSTGRES_PASSWORD=tally
REDIS_URL=redis://localhost:6380/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=tally
S3_SECRET_KEY=tally12345
# stripe-mock for offline work; leave empty to hit Stripe test mode
STRIPE_API_BASE=http://localhost:12111
# Restricted key (rk_test_...) from the sandbox: Customers write, PaymentIntents write. Never commit it.
STRIPE_TEST_SECRET_KEY=
# Temporal dev server from compose; empty means payment failures start no dunning workflow
TEMPORAL_ADDRESS=localhost:7233
# Jaeger from compose; empty disables trace export. Only runserver and the Celery worker export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Every request is traced by default; once volume matters keep one in ten:
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# From `stripe listen` output
STRIPE_WEBHOOK_SECRET=
